# Vera 零代码部署配置。首次使用复制为 .env 后按需修改：
#   cp .env.example .env
# 留空表示用默认值，想改哪项就填哪项。

# ── 必填：你的模型服务地址 ─────────────────────────────────
# 网关会把推理请求原样转发到这里，只需填 HTTP 地址。
# 留空默认 http://host.docker.internal:9000（模型跑在同一台宿主机可留空）。
GATEWAY_UPSTREAM=http://your-model-host:9000

# ── 可选：镜像版本（留空默认 latest）───────────────────────
VERA_IMAGE_TAG=

# ── 可选：漂移检测参数（留空默认 5/30/30/60/0.05/0.1/50）───
# 当前窗口(分钟)、基准窗口间隔(分钟)、基准窗口时长(分钟)、
# 检测间隔(秒)、KS 检验阈值、PSI 阈值、最少事件数
DETECTOR_CURRENT_MINUTES=
DETECTOR_BASELINE_OFFSET=
DETECTOR_BASELINE_MINUTES=
DETECTOR_SCAN_INTERVAL=
DETECTOR_KS_THRESHOLD=
DETECTOR_PSI_THRESHOLD=
DETECTOR_MIN_EVENTS=

# ── 可选：告警通知（webhook 留空关闭告警）──────────────────
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_MINUTES=

# ── 可选：根因分析参数（留空默认 5/30/30/20/5）──────────────
# 当前窗口(分钟)、基准窗口间隔(分钟)、基准窗口时长(分钟)、
# 最少事件数、报告展示的特征/子群数量
RC_CURRENT_MINUTES=
RC_BASELINE_OFFSET=
RC_BASELINE_MINUTES=
RC_MIN_EVENTS=
RC_TOP_K=
