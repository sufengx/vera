# Vera 零代码部署配置。首次使用复制为 .env 后按需修改：
#   cp .env.example .env
# 所有变量都有默认值，不写也能正常启动；只改你关心的即可。

# ── 必填：你的模型服务地址 ─────────────────────────────────
# 网关会把推理请求原样转发到这里，只需填 HTTP 地址。
# 留空默认 http://host.docker.internal:9000（模型跑在同一台宿主机可留空）。
GATEWAY_UPSTREAM=http://your-model-host:9000

# ── 可选：镜像版本 ─────────────────────────────────────────
# 发布版本号，如 0.2.0；留空默认 latest
# VERA_IMAGE_TAG=0.2.0

# ── 可选：漂移检测参数 ─────────────────────────────────────
# DETECTOR_CURRENT_MINUTES=5       # 当前窗口：检测最近几分钟的数据
# DETECTOR_BASELINE_OFFSET=30      # 基准窗口与当前窗口的间隔（分钟）
# DETECTOR_BASELINE_MINUTES=30     # 基准窗口时长（分钟）
# DETECTOR_SCAN_INTERVAL=60        # 检测间隔（秒）
# DETECTOR_KS_THRESHOLD=0.05       # KS 检验显著性阈值，越小越严格
# DETECTOR_PSI_THRESHOLD=0.1       # PSI 漂移阈值，越小越敏感
# DETECTOR_MIN_EVENTS=50           # 当前窗口最少事件数，不足不检测

# ── 可选：告警通知 ─────────────────────────────────────────
# ALERT_WEBHOOK_URL=               # 钉钉/企业微信/飞书等 webhook，留空关闭告警
# ALERT_COOLDOWN_MINUTES=15        # 同一指标两次告警的最小间隔（分钟）

# ── 可选：根因分析参数 ─────────────────────────────────────
# RC_CURRENT_MINUTES=5             # 当前窗口（分钟）
# RC_BASELINE_OFFSET=30            # 基准窗口与当前窗口的间隔（分钟）
# RC_BASELINE_MINUTES=30           # 基准窗口时长（分钟）
# RC_MIN_EVENTS=20                 # 当前窗口最少事件数，不足不分析
# RC_TOP_K=5                       # 报告中展示的特征/子群数量
